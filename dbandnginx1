
services:
  nginx:
    image: nginx:alpine
    container_name: web_server
    ports:
      - "8080:80"
      - "8443:443"

  mysql:
    image: mysql:latest
    container_name: Mysqldb
    ports:
      - "3306:3306"
    environment:
      MYSQL_ROOT_PASSWORD: supersecret
      MYSQL_DATABASE: wordpress
      MYSQL_USER: wordpress
      MYSQL_PASSWORD: wordpress
